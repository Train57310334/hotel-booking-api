# Rename to .env for local dev
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hotel_booking?schema=public"
JWT_SECRET="change-me"
PORT=3001
APP_NAME="Hotel Booking API"

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Mock Payment: ONLY enable in development (never in production)
ALLOW_MOCK_PAYMENT=true

# Email (Ethereal for dev)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BookingKub <no-reply@bookingkub.com>"
